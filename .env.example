# Скопируйте этот файл в .env и заполните своими значениями.

# Telegram API credentials (получить на https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# VK API credentials
VK_APP_ID=

# Safety settings
MAX_MESSAGES_PER_DAY=50
MIN_DELAY_SECONDS=50
MAX_DELAY_SECONDS=90
HUMAN_LIKE_DELAYS=true

# Database
DATABASE_PATH=data/leads.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
